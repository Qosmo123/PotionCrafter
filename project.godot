; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PotionCrafter"
config/description="3D tactile alchemical & arcane physics sandbox"
run/main_scene="res://scenes/main_bench.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="STATIC_BENCH"
3d_physics/layer_2="RIGID_VESSEL"
3d_physics/layer_3="SOLID_REAGENT"
3d_physics/layer_4="TACTILE_TOOL"
3d_physics/layer_5="POUR_STREAM_RAY"
3d_physics/layer_6="TERRARIUM_ENTITY"
3d_physics/layer_7="SNAP_SOCKET"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/position_steps=4
jolt_physics_3d/simulation/penetration_slop=0.002
jolt_physics_3d/simulation/speculative_contact_distance=0.004
jolt_physics_3d/simulation/sleep_velocity_threshold=0.005
jolt_physics_3d/collisions/collision_margin_fraction=0.02
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
scaling_3d/mode=2
environment/volumetric_fog/volume_size=96
anti_aliasing/quality/msaa_3d.mobile=1
scaling_3d/mode.mobile=0

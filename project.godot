; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PotionCrafter"
config/description="3D tactile alchemical & arcane physics sandbox"
run/main_scene="res://scenes/main_bench.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

SimConstants="*res://core/simulation/sim_constants.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="STATIC_BENCH"
3d_physics/layer_2="RIGID_VESSEL"
3d_physics/layer_3="SOLID_REAGENT"
3d_physics/layer_4="TACTILE_TOOL"
3d_physics/layer_5="POUR_STREAM_RAY"
3d_physics/layer_6="TERRARIUM_ENTITY"
3d_physics/layer_7="SNAP_SOCKET"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1

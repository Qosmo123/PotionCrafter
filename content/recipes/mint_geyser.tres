[resource]
script = ExtResource("1_recipe")
recipe_id = &"mint_geyser"
title = "The Mint Geyser"
category = 0
formula = "CO₂(aq) → CO₂(g) on rough nucleation sites"
description = "Millions of tiny pits on the mint give dissolved gas somewhere to bubble from — all at once!"
riddle = ""
